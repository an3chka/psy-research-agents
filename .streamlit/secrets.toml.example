# Скопируйте этот файл в .streamlit/secrets.toml и вставьте свой ключ.
# На Streamlit Cloud то же самое вставляется в Settings → Secrets.
OPENROUTER_API_KEY = "sk-or-v1-..."

# Необязательно:
# APP_PASSWORD = "..."   # пароль, без которого нейросеть на сайте не включается
# OPENROUTER_MODEL = "google/gemma-4-31b-it:free"
# NCBI_API_KEY = "..."   # ускоряет PubMed (10 запросов/с вместо 3)
